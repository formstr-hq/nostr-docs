# Copy to .env.local (gitignored) and fill in — never commit real values.

# Zapstore external-signing opt-in (read by the zapstore/zsp CLI when publishing).
# SIGN_WITH=

# Android release signing (used by `gradle assembleRelease`; see android/app/build.gradle).
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
